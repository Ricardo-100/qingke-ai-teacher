# Copy to .env. Keys stay on the local server, never in the frontend bundle.
AI_API_KEY=
# OpenAI-compatible Chat Completions endpoint; include /v1 when required.
AI_BASE_URL=https://api.openai.com/v1
# Set a model supported by your provider. Enable vision in the UI only if supported.
AI_MODEL=
AI_VISION=false
# Optional custom speech service. Saved automatically by the speech settings UI.
TTS_API_KEY=
TTS_BASE_URL=
TTS_MODEL=
TTS_VOICE=
PORT=8787
